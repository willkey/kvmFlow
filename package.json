{
  "name": "kvmflow-workspace",
  "private": true,
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=22.14.0 <23" },
  "workspaces": ["packages/ui-contracts", "apps/windows/ui", "apps/macos/ui"],
  "scripts": {
    "lint": "eslint packages/ui-contracts/src apps/*/ui/src --no-error-on-unmatched-pattern --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:package-layout",
    "test:package-layout": "node --test scripts/verify-package-layout.test.mjs scripts/export-clean-package.test.mjs scripts/package-baseline-macos.test.mjs scripts/package-baseline-windows.test.mjs scripts/verify-release-version.test.mjs",
    "release:check": "node scripts/verify-release-version.mjs",
    "build": "npm run build --workspaces --if-present",
    "tauri:windows:dev": "cd apps/windows && tauri dev",
    "tauri:windows:build": "cd apps/windows && tauri build",
    "tauri:macos:dev": "cd apps/macos && tauri dev",
    "tauri:macos:build": "cd apps/macos && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
